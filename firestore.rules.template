rules_version = '2';

// NOTE: this is a TEMPLATE. The real `firestore.rules` is generated by
// `dev/render-firestore-rules.sh`, which injects the allowed emails from the
// private watermeter-config repo. `firestore.rules` is gitignored — never edit
// it by hand, and never commit it (it contains the family's email addresses).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [__ALLOWED_EMAILS__];
    }

    // Desired valve state, written by the PWA and watched by the rpi.
    // Field-level validation (e.g. level range) is tightened in Phase 2.
    match /valve/{doc} {
      allow read, write: if isAllowed();
    }

    // Per-device FCM push tokens. Tightened in Phase 3.
    match /pushTokens/{token} {
      allow read, write: if isAllowed();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
