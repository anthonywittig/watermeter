rules_version = '2';

// NOTE: this is a TEMPLATE. The real `firestore.rules` is generated by
// `dev/render-config.sh`, which injects the allowed emails from the private
// watermeter-config repo. `firestore.rules` is gitignored — never edit it by
// hand, and never commit it (it contains the family's email addresses).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [__ALLOWED_EMAILS__];
    }

    // Desired valve state, written by the PWA and watched by the rpi.
    // level <= 0 means closed/off, > 0 means open/on.
    match /valve/{doc} {
      allow read: if isAllowed();
      allow write: if isAllowed()
        && request.resource.data.level is number
        && request.resource.data.requestedBy == request.auth.token.email;
    }

    // Per-device FCM push tokens, written by the PWA (doc id == the token).
    // The rpi reads these via the Admin SDK, which bypasses rules — clients
    // never need to read them, so keep each other's tokens private.
    match /pushTokens/{token} {
      allow read: if false;
      allow create, update: if isAllowed()
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAllowed();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
