DATABASE_CONNECTION=postgres:///water?host=/var/run/postgresql/&user=[USER]&password=[PASSWORD]
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS=/home/pi/projects/watermeter/bin/service-account.json
# IANA timezone for the usage chart's daily (year-view) buckets; default UTC.
USAGE_TIMEZONE=UTC
# Push-notify the family if no meter pulses arrive for this many hours
# (sensor/wiring fault detection). Optional; defaults to 12.
#STALL_ALERT_HOURS=12
